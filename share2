// src/App.jsx
import React, { useEffect, useState } from "react";
import {
  BrowserRouter as Router,
  Routes,
  Route,
  Navigate,
} from "react-router-dom";

// Example: Lazy loader for dynamic imports
const lazyImport = (path) =>
  React.lazy(() =>
    import(`./pages${path}.jsx`).catch(() => import("./pages/NotFound.jsx"))
  );

// Recursive function to render routes
const renderRoutes = (menus) =>
  menus.map((item) => {
    const Component = lazyImport(item.component);

    return item.children && item.children.length > 0 ? (
      <Route key={item.route} path={item.route} element={<Component />}>
        {renderRoutes(item.children)}
      </Route>
    ) : (
      <Route
        key={item.route}
        path={item.route}
        element={
          <React.Suspense fallback={<div>Loading...</div>}>
            <Component />
          </React.Suspense>
        }
      />
    );
  });

function App() {
  const [menuData, setMenuData] = useState([]);

  useEffect(() => {
    // Simulating API call
    const fetchData = async () => {
      const response = {
        success: true,
        message: "Login successful",
        data: {
          menu: [
            {
              title: "Dashboard",
              route: "/dashboard",
              icon: "home",
              component: "/DashboardPage",
              children: [],
            },
            {
              title: "User Management",
              route: "/users",
              icon: "people",
              component: "UserManagementPage",
              children: [
                {
                  title: "View All Users",
                  route: "/users/list",
                  icon: "view_list",
                  component: "./UserListPage",
                },
                {
                  title: "Create User",
                  route: "/users/new",
                  icon: "person_add",
                  component: "../PSO/CreateUserPage",
                },
              ],
            },
            {
              title: "Products",
              route: "/products",
              icon: "shopping_cart",
              component: "ProductsPage",
              children: [],
            },
            {
              title: "Settings",
              route: "/settings",
              icon: "settings",
              component: "SettingsPage",
              children: [],
            },
          ],
        },
      };

      setMenuData(response.data.menu);
    };

    fetchData();
  }, []);

  return (
    <Router>
      <Routes>
        {/* Default redirect */}
        <Route path="/" element={<Navigate to="/dashboard" replace />} />

        {/* Dynamically render routes */}
        {renderRoutes(menuData)}

        {/* Fallback route */}
        <Route path="*" element={<div>404 Not Found</div>} />
      </Routes>
    </Router>
  );
}

export default App;