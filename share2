import { Routes, Route } from "react-router-dom";
import Login from "../features/auth/pages/Login";
import Home from "../pages/Home";
import PrivateRouter from "./PrivateRouter";
import ServerError from "../pages/ServerError";
import NotFound from "../pages/NotFound";
import HomeLayout from "../layout/HomeLayout";
import { SnackbarProviderComponent } from "../utils/SnackbarContext";
import UCORouter from "./UCORouter";
import PSORouter from "./PSORouter";
import FRTRouter from "./FRTRouter";
import BranchRouter from "./BranchRouter";
import SupportRouter from "./SupportRouter";
import GLIFRouter from "./GLIFRouter";
import F1BogRouter from "./F1BogRouter";
import ExtUserRouter from "./ExtUserRouter";

const AppRouter = () => {
  return (
    <SnackbarProviderComponent>
      <Routes>
        <Route path="/" element={<Login />} />
        <Route path="/server-error" element={<ServerError />} />
        <Route path="/blank" element={<Home></Home>} />
        <Route path="*" element={<NotFound />} />

        {/* Landing page */}
        <Route
          path="/home"
          element={
            <PrivateRouter>
              <HomeLayout />
            </PrivateRouter>
          }
        />

        {/* Router for handling all UCO User related routes */}
        <Route element={<HomeLayout />}>
          <Route
            path="uco/*"
            element={
              <PrivateRouter allowedRoles={["51"]}>
                <UCORouter />
              </PrivateRouter>
            }
          />
        </Route>

        {/* Router for handling all PSO User related routes */}
        <Route element={<HomeLayout />}>
          <Route
            path="pso/*"
            element={
              <PrivateRouter allowedRoles={["52"]}>
                <PSORouter />
              </PrivateRouter>
            }
          />
        </Route>

        {/* Router for handling all FRT User related routes */}
        <Route element={<HomeLayout />}>
          <Route
            path="frt/*"
            element={
              <PrivateRouter allowedRoles={["53"]}>
                <FRTRouter />
              </PrivateRouter>
            }
          />
        </Route>

        {/* Router for handling all FRT User related routes */}
        <Route element={<HomeLayout />}>
          <Route
            path="branch/*"
            element={
              <PrivateRouter allowedRoles={["54"]}>
                <BranchRouter />
              </PrivateRouter>
            }
          />
        </Route>

        {/* Router for handling all FRT User related routes */}
        <Route element={<HomeLayout />}>
          <Route
            path="support/*"
            element={
              <PrivateRouter allowedRoles={["55"]}>
                <SupportRouter />
              </PrivateRouter>
            }
          />
        </Route>

        {/* Router for handling all GLIF User related routes */}
        <Route element={<HomeLayout />}>
          <Route
            path="glif/*"
            element={
              <PrivateRouter allowedRoles={["56"]}>
                <GLIFRouter />
              </PrivateRouter>
            }
          />
        </Route>

        {/* Router for handling all GLIF User related routes */}
        <Route element={<HomeLayout />}>
          <Route
            path="f1bog/*"
            element={
              <PrivateRouter allowedRoles={["57"]}>
                <F1BogRouter />
              </PrivateRouter>
            }
          />
        </Route>

        {/* Router for handling all GLIF User related routes */}
        <Route element={<HomeLayout />}>
          <Route
            path="extusers/*"
            element={
              <PrivateRouter allowedRoles={["58"]}>
                <ExtUserRouter />
              </PrivateRouter>
            }
          />
        </Route>
      </Routes>
    </SnackbarProviderComponent>
  );
};

export default AppRouter;


