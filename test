        <div style={styles.sliderContainer}>
          <button 
            onClick={prevSlide} 
            style={{...styles.sliderButton, left: '0'}}
            onMouseOver={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.25)'} 
            onMouseOut={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.15)'}
          >
            <ChevronLeftIcon />
          </button>
          
          <div style={styles.plantsGrid}>
            {plants.map((plant, index) => (
              <div 
                key={index} 
                style={index === 0 ? {...styles.plantCard, ...styles.plantCardActive} : styles.plantCard}
              >
                <div style={styles.plantCardContent}>
                  <div style={styles.plantCardInfo}>
                    <h3 style={styles.plantCardTitle}>{plant.name}</h3>
                    <p style={styles.plantCardDescription}>
                      {plant.description}
                    </p>
                  </div>
                  <div style={styles.plantEmoji}>{plant.image}</div>
                </div>
                
                <div style={styles.plantCardFooter}>
                  <span style={styles.plantPrice}>{plant.price}</span>
                  <button 
                    style={styles.addButton}
                    onMouseOver={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.25)'} 
                    onMouseOut={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.15)'}
                  >
                    <AddIcon />
                  </button>
                </div>
              </div>
            ))}
          </div>
          
          <button 
            onClick={nextSlide} 
            style={{...styles.sliderButton, right: '0'}}
            onMouseOver={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.25)'} 
            onMouseOut={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.15)'}
