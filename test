# Script: Install-VPNSoftwares.ps1
# Purpose: Automatically install all software from "C:\VPN Softwares" and subfolders

$softwarePath = "C:\VPN Softwares"

# Get all installer files recursively (.exe and .msi)
$installers = Get-ChildItem -Path $softwarePath -Recurse -Include *.exe, *.msi

foreach ($installer in $installers) {
    Write-Host "Installing $($installer.FullName) ..." -ForegroundColor Green
    
    try {
        if ($installer.Extension -eq ".msi") {
            # Install MSI silently
            Start-Process "msiexec.exe" -ArgumentList "/i `"$($installer.FullName)`" /quiet /norestart" -Wait -NoNewWindow
        } elseif ($installer.Extension -eq ".exe") {
            # Try silent EXE installation (most installers support /S or /quiet)
            Start-Process $installer.FullName -ArgumentList "/S /quiet /norestart" -Wait -NoNewWindow
        }
        
        Write-Host "✅ Installed: $($installer.Name)" -ForegroundColor Cyan
    } catch {
        Write-Host "❌ Failed to install: $($installer.Name)" -ForegroundColor Red
    }
}