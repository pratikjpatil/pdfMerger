              Add to Cart
            </button>
          </div>

          <button style={styles.knowMoreButton}>
            Know More 
            <ChevronRightIcon style={{marginLeft: '4px'}} />
          </button>
        </div>

        {/* Right Content - Plant Image with Info Cards */}
        <div style={styles.rightContent}>
