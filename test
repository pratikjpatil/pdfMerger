            <div style={{...styles.infoDot, backgroundColor: '#FCD34D'}}></div>
            <span style={styles.infoText}>Atmosphere: Sunny</span>
          </div>

          <div style={{...styles.infoCard, ...styles.waterCard}}>
            <div style={{...styles.infoDot, backgroundColor: '#60A5FA'}}></div>
            <span style={styles.infoText}>Water Level: 450ml</span>
          </div>

          <div style={{...styles.infoCard, ...styles.humidityCard}}>
            <div style={{...styles.infoDot, backgroundColor: '#34D399'}}></div>
            <span style={styles.infoText}>Humidity: 10%</span>
