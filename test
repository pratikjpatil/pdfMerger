const DoplantInterface = () => {
  const [quantity, setQuantity] = useState(1);
  const [currentSlide, setCurrentSlide] = useState(0);

  const plants = [
    {
      name: "Aloevera",
      price: "$300",
      description: "Aloe Vera is easy to grow, requires minimal maintenance.",
      image: "🌿"
    },
    {
      name: "Golden Barrel Cactus",
      price: "$800",
      description: "It thrives in full sun and well-draining soil. choice for garden.",
      image: "🌵"
    },
    {
      name: "Monstera Deliciosa",
      price: "$400",
      description: "Excellent decorative plant but also helps purify the air.",
      image: "🍃"
    },
    {
      name: "Sansevieria",
      price: "$500",
      description: "Absorb toxins and improve indoor air quality. CO₂ → oxygen",
      image: "🌱"
    }
  ];

  const increaseQuantity = () => setQuantity(prev => prev + 1);
  const decreaseQuantity = () => setQuantity(prev => prev > 1 ? prev - 1 : 1);

  const nextSlide = () => {
    setCurrentSlide((prev) => (prev + 1) % plants.length);
  };

  const prevSlide = () => {
    setCurrentSlide((prev) => (prev - 1 + plants.length) % plants.length);
  };

  return (
    <div style={styles.container}>
      {/* Header */}
      <header style={styles.header}>
        <div style={styles.logo}>
          <div style={styles.logoIcon}>
            <span style={styles.logoText}>D</span>
          </div>
          <span style={styles.logoTitle}>Doplant</span>
        </div>
        
        <div style={styles.searchContainer}>
          <SearchIcon style={styles.searchIcon} />
          <input
            type="text"
            placeholder="Find your plant..."
            style={styles.searchInput}
          />
        </div>

        <div style={styles.navIcons}>
          <button style={styles.iconButton} onMouseOver={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.2)'} 
                  onMouseOut={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.1)'}>
            <ShoppingCartIcon />
          </button>
          <button style={styles.iconButton} onMouseOver={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.2)'} 
                  onMouseOut={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.1)'}>
            <PersonIcon />
          </button>
          <button style={styles.iconButton} onMouseOver={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.2)'} 
