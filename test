            <MenuIcon />
          </button>
        </div>
      </header>

      {/* Main Content */}
      <div style={styles.mainContent}>
        {/* Left Content */}
        <div style={styles.leftContent}>
          <h1 style={styles.mainTitle}>Aloevera</h1>
          
          <div style={styles.priceSection}>
            <span style={styles.price}>$300</span>
            <div style={styles.socialProof}>
              <GroupIcon style={styles.peopleIcon} />
              <span style={styles.peopleText}>200 people have planted this</span>
            </div>
          </div>

          <p style={styles.description}>
            Aloe Vera is a popular succulent plant known for its thick, fleshy 
            leaves filled with a soothing gel. It is widely used for skincare, hair 
            care, and medicinal purposes due to its hydrating healing properties.
          </p>

          <div style={styles.actionSection}>
            <div style={styles.quantitySelector}>
              <button 
                style={styles.quantityButton}
                onClick={decreaseQuantity}
                onMouseOver={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.3)'} 
                onMouseOut={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.2)'}
              >
                <RemoveIcon />
              </button>
              <span style={styles.quantity}>{quantity}</span>
              <button 
                style={styles.quantityButton}
                onClick={increaseQuantity}
                onMouseOver={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.3)'} 
                onMouseOut={(e) => e.target.style.backgroundColor = 'rgba(255, 255, 255, 0.2)'}
