# =============================================================================
# GitLab CI/CD Pipeline — Java Spring Boot (Maven) → JFrog Artifactory → K8s
# Environment : Air-gapped / Internal SBI Enterprise
# GitLab Host  : gitlab.sbi
# Registry    : JFrog Artifactory (Docker + Maven repos)
# Target      : Kubernetes Cluster (kubectl / Helm)
# =============================================================================

# ---------------------------------------------------------------------------
# Global Variables — override via GitLab CI/CD Settings > Variables
# ---------------------------------------------------------------------------
variables:

  # ── JFrog Artifactory ──────────────────────────────────────────────────────
  JFROG_URL:              "https://artifactory.sbi"                 # Artifactory base URL
  JFROG_DOCKER_REGISTRY:  "artifactory.sbi/docker-local"           # Docker registry in Artifactory
  JFROG_MAVEN_REPO:       "artifactory.sbi/artifactory/libs-release"# Maven release repo
  JFROG_MAVEN_SNAPSHOT:   "artifactory.sbi/artifactory/libs-snapshot"# Maven snapshot repo
  # JFROG_USER / JFROG_PASSWORD / JFROG_API_KEY  →  set as masked CI/CD vars

  # ── Application ───────────────────────────────────────────────────────────
  APP_NAME:               "$CI_PROJECT_NAME"
  APP_VERSION:            "1.0.${CI_PIPELINE_IID}"
  DOCKER_IMAGE:           "${JFROG_DOCKER_REGISTRY}/${APP_NAME}"
  DOCKER_TAG:             "${APP_VERSION}-${CI_COMMIT_SHORT_SHA}"
  DOCKER_IMAGE_FULL:      "${DOCKER_IMAGE}:${DOCKER_TAG}"
  DOCKER_IMAGE_LATEST:    "${DOCKER_IMAGE}:latest"

  # ── Maven ─────────────────────────────────────────────────────────────────
  MAVEN_OPTS:             "-Dmaven.repo.local=${CI_PROJECT_DIR}/.m2/repository
                           -Dmaven.wagon.http.ssl.insecure=false
                           -Xmx1024m"
  MAVEN_CLI_OPTS:         "--batch-mode --errors --fail-at-end
                           --no-transfer-progress
                           -s ${CI_PROJECT_DIR}/ci/settings.xml"

  # ── Kubernetes ────────────────────────────────────────────────────────────
  K8S_NAMESPACE_DEV:      "dev"
  K8S_NAMESPACE_UAT:      "uat"
  K8S_NAMESPACE_PROD:     "prod"
  HELM_CHART_DIR:         "helm/${APP_NAME}"
  HELM_RELEASE_NAME:      "${APP_NAME}"
  # KUBECONFIG_DEV / KUBECONFIG_UAT / KUBECONFIG_PROD → set as file-type CI/CD vars

  # ── Docker build ──────────────────────────────────────────────────────────
  DOCKER_BUILDKIT:        "1"
  DOCKER_TLS_CERTDIR:     "/certs"


# ---------------------------------------------------------------------------
# Pipeline Stages
# ---------------------------------------------------------------------------
stages:
  - validate
  - build
  - test
  - quality
  - package
  - publish
  - deploy-dev
  - deploy-uat
  - deploy-prod


# ---------------------------------------------------------------------------
# Reusable Base Images (all pulled from Artifactory — no DockerHub)
# ---------------------------------------------------------------------------
.image_maven: &image_maven
  image: "${JFROG_DOCKER_REGISTRY}/maven:3.9-eclipse-temurin-21"

.image_docker: &image_docker
  image: "${JFROG_DOCKER_REGISTRY}/docker:24-dind"
  services:
    - name: "${JFROG_DOCKER_REGISTRY}/docker:24-dind"
      alias: docker
  variables:
    DOCKER_HOST: "tcp://docker:2376"
    DOCKER_TLS_VERIFY: "1"
    DOCKER_CERT_PATH: "$DOCKER_TLS_CERTDIR/client"

.image_helm: &image_helm
  image: "${JFROG_DOCKER_REGISTRY}/alpine/helm:3.14"


# ---------------------------------------------------------------------------
# Cache — Maven local repository cached per branch
# ---------------------------------------------------------------------------
.maven_cache: &maven_cache
  cache:
    key: "maven-${CI_COMMIT_REF_SLUG}"
    paths:
      - .m2/repository
    policy: pull-push


# ---------------------------------------------------------------------------
# Before-script helpers
# ---------------------------------------------------------------------------
.docker_login: &docker_login
  before_script:
    - echo "Logging into JFrog Artifactory Docker Registry..."
    - echo "$JFROG_PASSWORD" | docker login "$JFROG_DOCKER_REGISTRY"
        --username "$JFROG_USER" --password-stdin

.kubectl_setup: &kubectl_setup
  before_script:
    - kubectl version --client


# ---------------------------------------------------------------------------
# STAGE: validate
# Goal : Fail fast — check POM, code style, dependency security
# ---------------------------------------------------------------------------
validate:pom:
  stage: validate
  <<: *image_maven
  <<: *maven_cache
  script:
    - echo "==> Validating POM structure"
    - mvn $MAVEN_CLI_OPTS validate
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH'

validate:checkstyle:
  stage: validate
  <<: *image_maven
  <<: *maven_cache
  script:
    - echo "==> Running Checkstyle"
    - mvn $MAVEN_CLI_OPTS checkstyle:check
  allow_failure: false
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH'

validate:dependency-check:
  stage: validate
  <<: *image_maven
  <<: *maven_cache
  script:
    - echo "==> OWASP Dependency vulnerability check"
    - mvn $MAVEN_CLI_OPTS org.owasp:dependency-check-maven:check
        -DfailBuildOnCVSS=7
        -DdataDirectory=${CI_PROJECT_DIR}/.owasp-data
  cache:
    key: "owasp-${CI_COMMIT_REF_SLUG}"
    paths:
      - .owasp-data
      - .m2/repository
    policy: pull-push
  artifacts:
    when: always
    paths:
      - target/dependency-check-report.html
    expire_in: 7 days
  rules:
    - if: '$CI_COMMIT_BRANCH == "main" || $CI_COMMIT_BRANCH == "develop"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'


# ---------------------------------------------------------------------------
# STAGE: build
# Goal : Compile and produce the JAR (skip tests here — tests run next)
# ---------------------------------------------------------------------------
build:compile:
  stage: build
  <<: *image_maven
  <<: *maven_cache
  script:
    - echo "==> Compiling application (version ${APP_VERSION})"
    - mvn $MAVEN_CLI_OPTS
        versions:set -DnewVersion=${APP_VERSION} -DgenerateBackupPoms=false
    - mvn $MAVEN_CLI_OPTS package -DskipTests
  artifacts:
    name: "${APP_NAME}-${APP_VERSION}-jar"
    paths:
      - target/*.jar
      - target/classes/
    expire_in: 1 day
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH'


# ---------------------------------------------------------------------------
# STAGE: test
# Goal : Unit tests + integration tests + coverage report
# ---------------------------------------------------------------------------
test:unit:
  stage: test
  <<: *image_maven
  <<: *maven_cache
  needs: ["build:compile"]
  script:
    - echo "==> Running Unit Tests"
    - mvn $MAVEN_CLI_OPTS test
        -Dspring.profiles.active=test
  artifacts:
    when: always
    reports:
      junit: target/surefire-reports/TEST-*.xml
    paths:
      - target/surefire-reports/
      - target/site/jacoco/
    expire_in: 7 days
  coverage: '/Total.*?([0-9]{1,3})%/'
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH'

test:integration:
  stage: test
  <<: *image_maven
  <<: *maven_cache
  needs: ["build:compile"]
  script:
    - echo "==> Running Integration Tests"
    - mvn $MAVEN_CLI_OPTS verify -DskipUnitTests
        -Dspring.profiles.active=integration-test
  artifacts:
    when: always
    reports:
      junit: target/failsafe-reports/TEST-*.xml
    paths:
      - target/failsafe-reports/
    expire_in: 7 days
  rules:
    - if: '$CI_COMMIT_BRANCH == "main" || $CI_COMMIT_BRANCH == "develop"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'


# ---------------------------------------------------------------------------
# STAGE: quality
# Goal : SonarQube static analysis (internal SonarQube instance)
# ---------------------------------------------------------------------------
quality:sonar:
  stage: quality
  <<: *image_maven
  <<: *maven_cache
  needs: ["test:unit"]
  script:
    - echo "==> SonarQube Analysis"
    - mvn $MAVEN_CLI_OPTS sonar:sonar
        -Dsonar.host.url=${SONAR_HOST_URL}
        -Dsonar.login=${SONAR_TOKEN}
        -Dsonar.projectKey=${CI_PROJECT_PATH_SLUG}
        -Dsonar.projectName="${APP_NAME}"
        -Dsonar.projectVersion="${APP_VERSION}"
        -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
        -Dsonar.qualitygate.wait=true
  allow_failure: false
  rules:
    - if: '$CI_COMMIT_BRANCH == "main" || $CI_COMMIT_BRANCH == "develop"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
  # SONAR_HOST_URL / SONAR_TOKEN → set as masked CI/CD variables


# ---------------------------------------------------------------------------
# STAGE: package
# Goal : Build Docker image and push to JFrog Artifactory
# ---------------------------------------------------------------------------
package:docker:
  stage: package
  <<: *image_docker
  <<: *docker_login
  needs: ["build:compile", "test:unit"]
  script:
    - echo "==> Building Docker image ${DOCKER_IMAGE_FULL}"
    - |
      docker build \
        --build-arg APP_VERSION="${APP_VERSION}" \
        --build-arg BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --build-arg GIT_COMMIT="${CI_COMMIT_SHA}" \
        --label "git.commit=${CI_COMMIT_SHA}" \
        --label "git.branch=${CI_COMMIT_REF_NAME}" \
        --label "build.pipeline=${CI_PIPELINE_ID}" \
        -t "${DOCKER_IMAGE_FULL}" \
        -t "${DOCKER_IMAGE_LATEST}" \
        -f Dockerfile .
    - echo "==> Pushing image to JFrog Artifactory"
    - docker push "${DOCKER_IMAGE_FULL}"
    - docker push "${DOCKER_IMAGE_LATEST}"
    - echo "IMAGE_TAG=${DOCKER_TAG}" >> build.env
  artifacts:
    reports:
      dotenv: build.env
    expire_in: 1 day
  rules:
    - if: '$CI_COMMIT_BRANCH == "main" || $CI_COMMIT_BRANCH == "develop"'

package:docker:mr:
  stage: package
  <<: *image_docker
  <<: *docker_login
  needs: ["build:compile", "test:unit"]
  script:
    - echo "==> Building Docker image for MR validation (no push)"
    - |
      docker build \
        --build-arg APP_VERSION="${APP_VERSION}" \
        -t "${DOCKER_IMAGE_FULL}" \
        -f Dockerfile . --no-cache
    - echo "==> Docker build OK (MR — image not pushed)"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'


# ---------------------------------------------------------------------------
# STAGE: publish
# Goal : Publish JAR to JFrog Artifactory Maven repo
# ---------------------------------------------------------------------------
publish:maven-artifact:
  stage: publish
  <<: *image_maven
  <<: *maven_cache
  needs: ["package:docker"]
  script:
    - echo "==> Publishing JAR to JFrog Artifactory Maven repo"
    - mvn $MAVEN_CLI_OPTS deploy -DskipTests
        -DaltDeploymentRepository=central::default::${JFROG_MAVEN_REPO}
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'


# ---------------------------------------------------------------------------
# STAGE: deploy-dev
# Goal : Helm deploy to DEV namespace (auto on develop branch)
# ---------------------------------------------------------------------------
deploy:dev:
  stage: deploy-dev
  <<: *image_helm
  <<: *kubectl_setup
  needs: ["package:docker"]
  environment:
    name: development
    url: "https://${APP_NAME}.dev.sbi"
    on_stop: teardown:dev
  variables:
    KUBECONFIG: "$KUBECONFIG_DEV"
    K8S_NAMESPACE: "$K8S_NAMESPACE_DEV"
  script:
    - echo "==> Deploying to DEV namespace [${K8S_NAMESPACE}]"
    - |
      helm upgrade --install "${HELM_RELEASE_NAME}" "${HELM_CHART_DIR}" \
        --namespace "${K8S_NAMESPACE}" \
        --create-namespace \
        --set image.repository="${DOCKER_IMAGE}" \
        --set image.tag="${IMAGE_TAG}" \
        --set image.pullSecrets[0].name="artifactory-registry-secret" \
        --set replicaCount=1 \
        --set spring.profiles.active=dev \
        --values "${HELM_CHART_DIR}/values-dev.yaml" \
        --timeout 5m \
        --wait \
        --atomic
    - echo "==> Verifying rollout"
    - kubectl rollout status deployment/"${HELM_RELEASE_NAME}"
        -n "${K8S_NAMESPACE}" --timeout=3m
  rules:
    - if: '$CI_COMMIT_BRANCH == "develop"'
      when: on_success

teardown:dev:
  stage: deploy-dev
  <<: *image_helm
  environment:
    name: development
    action: stop
  variables:
    KUBECONFIG: "$KUBECONFIG_DEV"
    K8S_NAMESPACE: "$K8S_NAMESPACE_DEV"
  script:
    - helm uninstall "${HELM_RELEASE_NAME}" -n "${K8S_NAMESPACE}" || true
  rules:
    - if: '$CI_COMMIT_BRANCH == "develop"'
      when: manual


# ---------------------------------------------------------------------------
# STAGE: deploy-uat
# Goal : Helm deploy to UAT namespace (manual gate on develop/main)
# ---------------------------------------------------------------------------
deploy:uat:
  stage: deploy-uat
  <<: *image_helm
  <<: *kubectl_setup
  needs: ["deploy:dev"]
  environment:
    name: uat
    url: "https://${APP_NAME}.uat.sbi"
  variables:
    KUBECONFIG: "$KUBECONFIG_UAT"
    K8S_NAMESPACE: "$K8S_NAMESPACE_UAT"
  script:
    - echo "==> Deploying to UAT namespace [${K8S_NAMESPACE}]"
    - |
      helm upgrade --install "${HELM_RELEASE_NAME}" "${HELM_CHART_DIR}" \
        --namespace "${K8S_NAMESPACE}" \
        --create-namespace \
        --set image.repository="${DOCKER_IMAGE}" \
        --set image.tag="${IMAGE_TAG}" \
        --set image.pullSecrets[0].name="artifactory-registry-secret" \
        --set replicaCount=2 \
        --set spring.profiles.active=uat \
        --values "${HELM_CHART_DIR}/values-uat.yaml" \
        --timeout 5m \
        --wait \
        --atomic
    - kubectl rollout status deployment/"${HELM_RELEASE_NAME}"
        -n "${K8S_NAMESPACE}" --timeout=3m
  rules:
    - if: '$CI_COMMIT_BRANCH == "develop" || $CI_COMMIT_BRANCH == "main"'
      when: manual
  allow_failure: false


# ---------------------------------------------------------------------------
# STAGE: deploy-prod
# Goal : Helm deploy to PROD namespace (manual + protected branch only)
# ---------------------------------------------------------------------------
deploy:prod:
  stage: deploy-prod
  <<: *image_helm
  <<: *kubectl_setup
  needs: ["deploy:uat"]
  environment:
    name: production
    url: "https://${APP_NAME}.sbi"
  variables:
    KUBECONFIG: "$KUBECONFIG_PROD"
    K8S_NAMESPACE: "$K8S_NAMESPACE_PROD"
  script:
    - echo "==> Deploying to PRODUCTION namespace [${K8S_NAMESPACE}]"
    - |
      helm upgrade --install "${HELM_RELEASE_NAME}" "${HELM_CHART_DIR}" \
        --namespace "${K8S_NAMESPACE}" \
        --create-namespace \
        --set image.repository="${DOCKER_IMAGE}" \
        --set image.tag="${IMAGE_TAG}" \
        --set image.pullSecrets[0].name="artifactory-registry-secret" \
        --set replicaCount=3 \
        --set spring.profiles.active=prod \
        --values "${HELM_CHART_DIR}/values-prod.yaml" \
        --timeout 10m \
        --wait \
        --atomic
    - echo "==> Production rollout verification"
    - kubectl rollout status deployment/"${HELM_RELEASE_NAME}"
        -n "${K8S_NAMESPACE}" --timeout=5m
    - echo "==> Running smoke tests against production"
    - |
      POD=$(kubectl get pod -n "${K8S_NAMESPACE}" \
        -l app="${HELM_RELEASE_NAME}" \
        -o jsonpath="{.items[0].metadata.name}")
      kubectl exec -n "${K8S_NAMESPACE}" "$POD" -- \
        wget -qO- http://localhost:8080/actuator/health | grep -q '"status":"UP"'
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'
      when: manual
  allow_failure: false

rollback:prod:
  stage: deploy-prod
  <<: *image_helm
  <<: *kubectl_setup
  needs: []
  environment:
    name: production
  variables:
    KUBECONFIG: "$KUBECONFIG_PROD"
    K8S_NAMESPACE: "$K8S_NAMESPACE_PROD"
  script:
    - echo "==> Rolling back PRODUCTION Helm release by 1 revision"
    - helm rollback "${HELM_RELEASE_NAME}" 0 -n "${K8S_NAMESPACE}" --wait
    - kubectl rollout status deployment/"${HELM_RELEASE_NAME}"
        -n "${K8S_NAMESPACE}" --timeout=3m
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'
      when: manual



