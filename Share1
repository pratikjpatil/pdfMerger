# =============================================================================
# Dockerfile — Spring Boot Application
# Base images pulled from JFrog Artifactory (no DockerHub access)
# Multi-stage: build stage kept separate to minimise final image size
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1 — Extract Spring Boot layers (requires Spring Boot 2.3+)
# The JAR is already built by Maven in CI; we just explode the layers here.
# ---------------------------------------------------------------------------
ARG JFROG_DOCKER_REGISTRY=artifactory.sbi/docker-local
ARG JRE_IMAGE=eclipse-temurin:21-jre-alpine

FROM ${JFROG_DOCKER_REGISTRY}/${JRE_IMAGE} AS layer-extractor

WORKDIR /extract

# Copy the fat JAR produced by Maven
COPY target/*.jar app.jar

# Explode Spring Boot layered JAR
RUN java -Djarmode=layertools -jar app.jar extract

# ---------------------------------------------------------------------------
# Stage 2 — Final minimal runtime image
# ---------------------------------------------------------------------------
FROM ${JFROG_DOCKER_REGISTRY}/${JRE_IMAGE}

# Build-time metadata (injected by GitLab CI)
ARG APP_VERSION=unknown
ARG BUILD_DATE=unknown
ARG GIT_COMMIT=unknown

# OCI standard labels
LABEL org.opencontainers.image.title="springboot-app" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.vendor="SBI" \
      maintainer="your-team@sbi"

# ── Security: run as non-root ──────────────────────────────────────────────
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
RUN chown appuser:appgroup /app

# ── Copy Spring Boot layers in cache-friendly order ───────────────────────
COPY --from=layer-extractor --chown=appuser:appgroup /extract/dependencies/          ./
COPY --from=layer-extractor --chown=appuser:appgroup /extract/spring-boot-loader/    ./
COPY --from=layer-extractor --chown=appuser:appgroup /extract/snapshot-dependencies/ ./
COPY --from=layer-extractor --chown=appuser:appgroup /extract/application/           ./

USER appuser

# ── JVM tuning for containers (Java 11+) ──────────────────────────────────
ENV JAVA_OPTS="\
  -XX:+UseContainerSupport \
  -XX:MaxRAMPercentage=75.0 \
  -XX:+ExitOnOutOfMemoryError \
  -Djava.security.egd=file:/dev/./urandom \
  -Dspring.backgroundpreinitializer.ignore=true"

# ── Spring profile injected at runtime via Helm values ────────────────────
ENV SPRING_PROFILES_ACTIVE=default

EXPOSE 8080

# ── Healthcheck using Spring Boot Actuator ────────────────────────────────
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", \
  "exec java $JAVA_OPTS \
   -Dspring.profiles.active=$SPRING_PROFILES_ACTIVE \
   org.springframework.boot.loader.JarLauncher"]


