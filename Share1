<?xml version="1.0" encoding="UTF-8"?>
<!--
  ci/settings.xml
  Maven settings for internal SBI environment.
  All dependencies resolved exclusively via JFrog Artifactory.
  Place this file at: <project-root>/ci/settings.xml
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <!-- ── Local repository inside the project dir (used by CI cache) ───── -->
  <localRepository>${CI_PROJECT_DIR}/.m2/repository</localRepository>

  <!-- ── JFrog Artifactory credentials ─────────────────────────────────── -->
  <servers>
    <server>
      <id>central</id>
      <username>${env.JFROG_USER}</username>
      <password>${env.JFROG_PASSWORD}</password>
    </server>
    <server>
      <id>snapshots</id>
      <username>${env.JFROG_USER}</username>
      <password>${env.JFROG_PASSWORD}</password>
    </server>
    <server>
      <id>artifactory-releases</id>
      <username>${env.JFROG_USER}</username>
      <password>${env.JFROG_PASSWORD}</password>
    </server>
  </servers>

  <!-- ── Mirror: redirect ALL external repos to Artifactory virtual repo ─ -->
  <mirrors>
    <mirror>
      <id>artifactory-all</id>
      <name>JFrog Artifactory — SBI Virtual Repo</name>
      <!--
        Use a single virtual repo in Artifactory that aggregates:
          - libs-release-local
          - libs-snapshot-local
          - maven-central (remote proxy)
          - jcenter (remote proxy)
          - spring-releases (remote proxy)
        Update URL to match your actual virtual repo name.
      -->
      <url>${env.JFROG_URL}/artifactory/maven-virtual</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>

  <!-- ── Active profile ─────────────────────────────────────────────────── -->
  <activeProfiles>
    <activeProfile>artifactory</activeProfile>
  </activeProfiles>

  <profiles>
    <profile>
      <id>artifactory</id>
      <repositories>
        <repository>
          <id>central</id>
          <url>${env.JFROG_URL}/artifactory/maven-virtual</url>
          <releases>  <enabled>true</enabled>  </releases>
          <snapshots> <enabled>false</enabled> </snapshots>
        </repository>
        <repository>
          <id>snapshots</id>
          <url>${env.JFROG_URL}/artifactory/libs-snapshot</url>
          <releases>  <enabled>false</enabled> </releases>
          <snapshots> <enabled>true</enabled>  </snapshots>
        </repository>
      </repositories>

      <pluginRepositories>
        <pluginRepository>
          <id>central</id>
          <url>${env.JFROG_URL}/artifactory/maven-virtual</url>
          <releases>  <enabled>true</enabled>  </releases>
          <snapshots> <enabled>false</enabled> </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

</settings>
