SQL Table Design
To store the data represented in the JSON, a relational database would typically use a set of normalized tables. The following SQL code defines a possible schema for roles, permissions, and a hierarchical menu system.
-- Table to store permissions
CREATE TABLE permissions (
    permission_id INT PRIMARY KEY,
    permission_name VARCHAR(50) NOT NULL UNIQUE,
    description VARCHAR(255),
    active CHAR(1) DEFAULT 'A' -- 'A' for Active, 'I' for Inactive
);

-- Table to store user roles
CREATE TABLE roles (
    role_id INT PRIMARY KEY AUTO_INCREMENT,
    role_name VARCHAR(50) NOT NULL UNIQUE
);

-- A junction table to link roles and permissions (many-to-many relationship)
CREATE TABLE role_permissions (
    role_id INT,
    permission_id INT,
    PRIMARY KEY (role_id, permission_id),
    FOREIGN KEY (role_id) REFERENCES roles(role_id),
    FOREIGN KEY (permission_id) REFERENCES permissions(permission_id)
);

-- Table to store menu items with support for parent-child relationships
CREATE TABLE menu_items (
    menu_id INT PRIMARY KEY AUTO_INCREMENT,
    title VARCHAR(100) NOT NULL,
    route VARCHAR(255) NOT NULL,
    icon VARCHAR(50),
    component VARCHAR(255),
    parent_id INT, -- This column will be NULL for top-level menu items
    FOREIGN KEY (parent_id) REFERENCES menu_items(menu_id)
);

