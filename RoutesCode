3. Repository: MenuItemRepository.java
This interface fetches data from the database. Spring Data JPA provides the implementation automatically.
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.stereotype.Repository;
import java.util.List;

@Repository
public interface MenuItemRepository extends JpaRepository<MenuItem, Long> {

    /**
     * Finds all top-level menu items that are active and sorts them by position.
     * Top-level items are those where parent_id is NULL.
     */
    @Query("SELECT m FROM MenuItem m WHERE m.parent_id IS NULL AND m.isActive = true ORDER BY m.position ASC")
    List<MenuItem> findActiveTopLevelMenuItems();
}

4. Service: MenuService.java
The service contains the business logic to fetch entities and map them to DTOs.
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import java.util.List;
import java.util.stream.Collectors;

@Service
public class MenuService {

    @Autowired
    private MenuItemRepository menuItemRepository;

    public List<MenuItemDto> getFullMenu() {
        List<MenuItem> topLevelItems = menuItemRepository.findActiveTopLevelMenuItems();
        return topLevelItems.stream()
                .map(this::convertToDto)
                .collect(Collectors.toList());
    }

    // A recursive method to map an entity and all its children to DTOs
    private MenuItemDto convertToDto(MenuItem menuItem) {
        MenuItemDto dto = new MenuItemDto();
        dto.setTitle(menuItem.getTitle());
        dto.setRoute(menuItem.getRoute());
        dto.setIcon(menuItem.getIcon());
        dto.setComponent(menuItem.getComponent());

        // Recursively convert children
        if (menuItem.getChildren() != null && !menuItem.getChildren().isEmpty()) {
            dto.setChildren(menuItem.getChildren().stream()
                    .map(this::convertToDto)
                    .collect(Collectors.toList()));
        }
        return dto;
    }
}

5. Controller: MenuController.java
This class exposes an HTTP endpoint to provide the menu data.
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import java.util.List;

@RestController
@RequestMapping("/api")
public class MenuController {

    @Autowired
    private MenuService menuService;

    @GetMapping("/menu")
    public ResponseEntity<MenuResponse> getMenu() {
        List<MenuItemDto> menuItems = menuService.getFullMenu();
        MenuResponse response = new MenuResponse(true, "Login successful", menuItems);
        return ResponseEntity.ok(response);
    }
}

