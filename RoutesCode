2. Controller Class
This REST controller defines an endpoint (/api/login) that builds and returns the complete response.
LoginController.java
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.Arrays;
import java.util.Collections;
import java.util.List;

@RestController
@RequestMapping("/api")
public class LoginController {

    @PostMapping("/login")
    public ResponseEntity<ApiResponse<LoginDataDto>> handleLogin() {
        
        // 1. Build the list of permissions
        List<PermissionDto> permissions = Arrays.asList(
            new PermissionDto(1234, "Delete", "Stroes permission for uco users", "A"),
            new PermissionDto(1235, "Create", "Stroes permission for uco users", "A"),
            new PermissionDto(1236, "Modify", "Stroes permission for uco users", "A")
        );

        // 2. Build the menu structure (with children)
        MenuDto userManagement = new MenuDto(
            "User Management",
            "/users",
            "people",
            "UserManagementPage",
            Arrays.asList(
                new MenuDto("View All Users", "/users/list", "view_list", "UserListPage", Collections.emptyList()),
                new MenuDto("Create User", "/users/new", "person_add", "../PSO/CreateUserPage", Collections.emptyList())
            )
        );

        List<MenuDto> menu = Arrays.asList(
            new MenuDto("Dashboard", "/dashboard", "home", "DashboardPage", Collections.emptyList()),
            userManagement,
            new MenuDto("Products", "/products", "shopping_cart", "ProductsPage", Collections.emptyList()),
            new MenuDto("Settings", "/settings", "settings", "SettingsPage", Collections.emptyList())
        );

        // 3. Build the main data object
        LoginDataDto loginData = new LoginDataDto(
            "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...", // Token
            permissions,
            menu
        );

        // 4. Wrap it in the final ApiResponse object
        ApiResponse<LoginDataDto> response = new ApiResponse<>(true, "Login successful", loginData);

        return ResponseEntity.ok(response);
    }
}

